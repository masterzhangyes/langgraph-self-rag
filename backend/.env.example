# ============================================================================
# 🔑 OpenAI API 配置（必填 — 不填程序无法运行）
# ============================================================================

# 你的 API 密钥（支持一切 OpenAI 兼容接口）
# 从哪里获取：
#   - 智谱 BigModel：https://open.bigmodel.cn/（本项目当前默认）
#   - OpenAI 官方：  https://platform.openai.com/api-keys
#   - DeepSeek：     https://platform.deepseek.com/api-keys
#   - 通义千问：     https://dashscope.aliyun.com
OPENAI_API_KEY=sk-your-api-key-here

# API 地址基 URL，决定了你的请求发往哪里（注意结尾 / 不能省略）
#   - 智谱（默认）：https://open.bigmodel.cn/api/paas/v4/
#   - OpenAI 官方： https://api.openai.com/v1
#   - DeepSeek：    https://api.deepseek.com/v1
#   - 通义千问：    https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 本地 Ollama： http://localhost:11434/v1
# 原理：所有兼容 OpenAI 接口的服务，只需要改这个 URL 就能切换
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/


# ============================================================================
# 🤖 LLM 模型配置（控制大模型"怎么说话"）
# ============================================================================

# 使用的模型名称（必须和上面 BASE_URL 对应）
#   - glm-4-flash        → 智谱免费模型（本项目当前默认）
#   - glm-4-plus         → 智谱更强模型（需开通）
#   - gpt-3.5-turbo      → OpenAI 轻量模型
#   - gpt-4o             → OpenAI 旗舰模型
#   - deepseek-chat      → DeepSeek 对话模型
#   - qwen-turbo         → 通义千问轻量模型
LLM_MODEL=glm-4-flash

# 温度参数（0.0 ~ 2.0），控制回答的"创造力"
#   0.0 = 最死板、最确定 → 适合事实性问答
#   0.3 = 轻微灵活       → 本项目的默认值
#   1.0 = 有创意         → 适合写作、头脑风暴
#   2.0 = 天马行空       → 可能胡说八道
LLM_TEMPERATURE=0.3

# 单次回答最多生成多少个 token（约等于多少个字）
#   中文：1 个 token ≈ 1.5 个汉字，所以 2048 token ≈ 3000 字
#   如果回答太长会被截断
LLM_MAX_TOKENS=2048


# ============================================================================
# 📐 嵌入模型（把文字变成数字向量，用于语义搜索）
# ============================================================================

# 云端嵌入模型（USE_LOCAL_EMBEDDINGS=false 时使用）
#   作用：把文本变成向量，再与知识库中的向量做相似度检索
#   智谱：embedding-3（当前默认，需在控制台开通模型权限）
#   OpenAI：text-embedding-3-small / text-embedding-ada-002
EMBEDDING_MODEL=embedding-3

# 是否使用本地嵌入模型？
#   false → 走云端 API（需要联网、付费、但无需 GPU）
#   true  → 在本地运行 HuggingFace 模型（免费、隐私好、但需要 CPU/GPU 算力）
# 本地运行时模型会被下载到 ~/.cache/huggingface/ 目录
USE_LOCAL_EMBEDDINGS=false

# 本地嵌入模型名称（USE_LOCAL_EMBEDDINGS=true 时才生效）
#   BAAI/bge-small-zh-v1.5  → 小模型，中文效果好，下载约 100MB
#   BAAI/bge-base-zh-v1.5   → 大模型，效果更好，下载约 400MB
#   来源：https://huggingface.co/BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5


# ============================================================================
# 📊 重排序模型（把检索结果"精排"，最准的放最前面）
# ============================================================================

# 重排序就是在检索拿到 20 条候选后，让一个更聪明的模型重新打分
# 选出最相关的 5 条送给 LLM 生成回答
# Cross-Encoder 比 Bi-Encoder（向量检索）更准，因为会把 query 和 doc 拼在一起联合打分
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-base


# ============================================================================
# 💾 向量数据库（把文档的"数字指纹"存起来，方便搜索）
# ============================================================================

# ChromaDB 的数据存储目录
#   默认在当前目录下的 chroma_db 文件夹
#   Docker 部署时会映射到 chrome-volume，实现数据持久化
VECTOR_DB_PATH=./chroma_db


# ============================================================================
# 📄 文档处理（上传的 PDF/TXT 怎么切块）
# ============================================================================

# 文档切块大小（字符数）
#   1000 字一块，为什么？
#   - 太小（100字）：一句话拆成好多块，语义不完整
#   - 太大（5000字）：一块包含太多无关内容，检索不准
#   - 1000 字是经验值，适合大多数场景
CHUNK_SIZE=1000

# 相邻切块之间的重叠字符数
#   200 字重叠，为什么？
#   - 防止一句话正好被切成两半，导致语义断裂
#   - 例如：原文档 1000字 → 第1块: [0-1000], 第2块: [800-1800]
CHUNK_OVERLAP=200

# 检索阶段返回多少条候选文档
#   20 条意味着先用 BM25 + 向量检索找到 20 条最相关的
#   然后交给重排序模型精选出 RERANK_TOP_K 条
RETRIEVAL_TOP_K=20

# 重排序后保留多少条送给 LLM（即最终塞进 prompt 的文档数）
#   5 条是经验值：太少信息不足，太多导致 prompt 过长、LLM 容易忽略
RERANK_TOP_K=5


# ============================================================================
# 🔀 RAG 功能开关（每个开关控制一段代码是否执行）
# ============================================================================

# 是否启用混合检索（BM25 关键词 + 向量语义 同时搜）
#   true  → 两种方法同时搜，用 RRF 算法融合排名 → 更准但稍慢
#   false → 只用向量检索                             → 更快但可能漏掉关键词匹配
ENABLE_HYBRID_RETRIEVAL=true

# 是否启用重排序
#   true  → 检索后用 Cross-Encoder 重新打分 → 更准但首次需下载模型（约 1GB+）
#   false → 直接用混合检索排序             → 更快、开箱即用（本项目当前默认）
# 提示：bge-reranker-base 等模型在 CPU 上推理较慢，建议先做小样本评估再启用
ENABLE_RERANKING=false

# 是否启用查询扩展（Agent 模式的第一步：把一个问法扩展为多种问法）
#   例如："什么是RAG" → ["RAG的定义", "检索增强生成原理", "RAG技术介绍"]
#   多种问法分别检索，合并去重 → 提高召回率
ENABLE_QUERY_EXPANSION=true

# 是否启用 Self-RAG（让 AI 自查"检索够不够好""回答有没有胡说"）
#   true  → Agent 模式：查询扩展 → 检索 → 相关性评估 → 幻觉检测（当前默认）
#   false → 简化模式：搜一次 → 生成 → 结束（调试更快）
#   注意：true 时每轮会多次调用 LLM，请确认模型配额与成本
ENABLE_SELF_RAG=true


# ============================================================================
# 💬 对话历史（多轮对话怎么控制）
# ============================================================================

# 最多保留多少轮历史对话
#   10 轮意味着最近 10 个问答会在下一轮中作为上下文发给 LLM
#   为什么要这个限制？
#   - 避免 prompt 太长（LLM 有最大输入限制）
#   - 避免费用过高（每轮历史都算 token 消耗）
#   - 避免"记忆混乱"（太久远的历史可能干扰当前问题）
MAX_HISTORY_ROUNDS=10

# Agent 模式下，检索不理想时最多重试几次
#   每次重试会改写查询词重新搜索
#   2 次是经验值：太少可能搜不到，太多浪费时间和 token
MAX_RETRIEVAL_RETRIES=2

# SQLite 数据库文件路径（存对话记录和会话信息）
#   相对路径，在 backend/ 目录下执行时会在 data/ 文件夹创建
DB_PATH=./data/chat.db


# ============================================================================
# 🚀 服务配置（FastAPI 服务器怎么运行）
# ============================================================================

# 服务监听地址
#   0.0.0.0 → 接受来自任何 IP 的连接（Docker 里必须用这个）
#   127.0.0.1 → 只接受本机连接（更安全，但 Docker 访问不到）
HOST=0.0.0.0

# 服务监听端口
#   开发环境：8001（与前端 Vite 的 5173 不冲突）
#   Docker 环境：8000（docker-compose 默认）
PORT=8000

# 调试模式
#   true  → 改代码自动重启、日志更详细、报错有堆栈 → 开发时用
#   false → 性能最优、日志简洁                        → 生产时用
DEBUG=false

# 日志级别（从少到多）
#   ERROR < WARNING < INFO < DEBUG
#   开发调试用 DEBUG，正常运行用 INFO
LOG_LEVEL=INFO

# 日志文件保存路径
#   所有 INFO 级别以上的日志都会写入这个文件（按天轮转）
LOG_PATH=./logs/app.log


# ============================================================================
# 🔒 安全配置（生产环境必须改！）
# ============================================================================

# 签名密钥（用于 session JWT 等加密场景）
#   生产环境必须改成随机字符串！
#   生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-use-a-random-string

# 是否启用 API 鉴权
#   true  → 所有接口需要在请求头带 X-API-Key → 对外开放时用
#   false → 免认证访问                         → 本地开发时用
API_AUTH_ENABLED=false

# API 鉴权时从请求头哪个字段读取密钥
#   默认 X-API-Key，也可以改成 Authorization 等
API_AUTH_HEADER=X-API-Key

# 接口频率限制
#   30/minute → 每分钟最多 30 次请求（平均每秒 0.5 次）
#   超过限制返回 429 Too Many Requests
RATE_LIMIT=30/minute
